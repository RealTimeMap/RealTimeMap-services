    {
      "id": "service-list-bugs",
      "method": "GET",
      "path": "/api/v2/service/bugs",
      "summary": "Перечень багов для привязки к задаче",
      "description": "Отдаёт баги, которые можно взять в работу задачей таск-менеджера. По умолчанию это только открытые (new, in work) и ещё не занятые другой задачей: именно их имеет смысл предлагать при создании задачи типа bug. Логи в перечень не попадают — они весят прилично и нужны только при чтении одного бага.",
      "tags": [
        "Межсервисные"
      ],
      "auth": false,
      "parameters": [
        {
          "name": "X-Api-Key",
          "type": "string",
          "required": true,
          "description": "Ключ межсервисного доступа (service_api_key из конфига). Заголовки пользователя здесь не используются: у фонового вызова пользователя нет.",
          "location": "header"
        },
        {
          "name": "tag",
          "type": "string",
          "required": false,
          "location": "query",
          "description": "Фильтр по категории бага"
        },
        {
          "name": "pageSize",
          "type": "integer",
          "required": false,
          "location": "query",
          "description": "Размер страницы, максимум 100"
        },
        {
          "name": "page",
          "type": "integer",
          "required": false,
          "location": "query",
          "description": "Номер страницы, начиная с единицы"
        },
        {
          "name": "includeClosed",
          "type": "boolean",
          "required": false,
          "location": "query",
          "description": "Не отбрасывать закрытые и отменённые баги"
        },
        {
          "name": "includeLinked",
          "type": "boolean",
          "required": false,
          "location": "query",
          "description": "Не отбрасывать баги, уже привязанные к задаче"
        }
      ],
      "responses": [
        {
          "statusCode": 200,
          "description": "Перечень багов",
          "schema": [
            {
              "name": "items",
              "type": "array",
              "required": true,
              "description": "Баги, доступные для привязки",
              "children": [
                {
                  "name": "id",
                  "type": "integer",
                  "required": true,
                  "description": "Идентификатор бага"
                },
                {
                  "name": "createdAt",
                  "type": "string",
                  "required": true,
                  "description": "Дата отправки отчёта (ISO 8601)"
                },
                {
                  "name": "title",
                  "type": "string",
                  "required": true,
                  "description": "Заголовок бага"
                },
                {
                  "name": "desc",
                  "type": "string",
                  "required": true,
                  "description": "Текст отчёта от пользователя"
                },
                {
                  "name": "tag",
                  "type": "string",
                  "required": true,
                  "description": "Категория бага",
                  "enum": [
                    "feature",
                    "ui",
                    "logic"
                  ]
                },
                {
                  "name": "status",
                  "type": "string",
                  "required": true,
                  "description": "Статус бага",
                  "enum": [
                    "new",
                    "in work",
                    "closed",
                    "canceled"
                  ]
                },
                {
                  "name": "platform",
                  "type": "string",
                  "required": true,
                  "description": "Платформа устройства"
                },
                {
                  "name": "build",
                  "type": "string",
                  "required": true,
                  "description": "Версия сборки приложения"
                },
                {
                  "name": "hasLogs",
                  "type": "boolean",
                  "required": true,
                  "description": "К отчёту приложен журнал"
                },
                {
                  "name": "userId",
                  "type": "integer",
                  "required": false,
                  "description": "Автор отчёта. Пусто, если баг отправлен анонимно"
                },
                {
                  "name": "taskId",
                  "type": "integer",
                  "required": false,
                  "description": "Задача таск-менеджера, в которой баг ведут. Пусто, пока баг свободен"
                },
                {
                  "name": "os",
                  "type": "string",
                  "required": false,
                  "description": "ОС и её версия"
                },
                {
                  "name": "resolution",
                  "type": "string",
                  "required": false,
                  "description": "Разрешение экрана строкой вида 1080x2400"
                },
                {
                  "name": "battery",
                  "type": "number",
                  "required": false,
                  "description": "Заряд батареи на момент отправки"
                }
              ]
            }
          ],
          "example": {
            "items": [
              {
                "id": 5,
                "createdAt": "2026-08-01T10:11:47Z",
                "title": "Маркер не обновляется после смены фильтра",
