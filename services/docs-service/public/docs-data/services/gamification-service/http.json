{
  "endpoints": [
    {
      "id": "get-levels",
      "method": "GET",
      "path": "/api/v2/level/",
      "summary": "Получить список уровней",
      "description": "Возвращает все уровни системы геймификации с информацией о необходимом опыте для достижения каждого уровня. Результат кэшируется (TTL 15 минут).\n\nМаршрут зарегистрирован с завершающим слэшем: запрос к /api/v2/level без слэша вернёт редирект 301 на /api/v2/level/.",
      "tags": [
        "Уровни"
      ],
      "responses": [
        {
          "statusCode": 200,
          "description": "Список всех уровней",
          "schema": [
            {
              "name": "level",
              "type": "integer",
              "required": true,
              "description": "Номер уровня"
            },
            {
              "name": "title",
              "type": "string",
              "required": true,
              "description": "Название уровня"
            },
            {
              "name": "xpRequired",
              "type": "integer",
              "required": true,
              "description": "Общий накопленный опыт, необходимый для достижения уровня"
            }
          ],
          "example": [
            {
              "level": 1,
              "title": "Новичок",
              "xpRequired": 0
            },
            {
              "level": 2,
              "title": "Исследователь",
              "xpRequired": 100
            },
            {
              "level": 3,
              "title": "Путешественник",
              "xpRequired": 250
            }
          ]
        }
      ],
      "errors": [
        "internal-error"
      ]
    },
    {
      "id": "create-achievement",
      "method": "POST",
      "path": "/api/v2/achievement/create",
      "summary": "Создать достижение",
      "description": "Создаёт новое достижение в системе. Достижение привязывается к типу события (triggerEvent) и активируется, когда счётчик действий пользователя достигает порога (threshold). Опционально может быть звеном цепочки прогрессий через nextId.\n\nДоступ только для администратора: проверка идёт по заголовкам X-User-ID и X-User-Admin — 401 при отсутствующем или некорректном X-User-ID, 403 если пользователь не администратор.",
      "tags": [
        "Достижения"
      ],
      "auth": true,
      "requestBody": {
        "description": "Параметры достижения в формате multipart/form-data (вместе с файлом иконки)",
        "contentType": "multipart/form-data",
        "schema": [
          {
            "name": "code",
            "type": "string",
            "required": true,
            "description": "Уникальный машинный код достижения"
          },
          {
            "name": "title",
            "type": "string",
            "required": true,
            "description": "Название достижения (отображается пользователю)"
          },
          {
            "name": "desc",
            "type": "string",
            "required": true,
            "description": "Описание достижения"
          },
          {
            "name": "triggerEvent",
            "type": "string",
            "required": true,
            "description": "Тип события, по которому считается прогресс (например, mark.created)"
          },
          {
            "name": "threshold",
            "type": "integer",
            "required": true,
            "description": "Количество событий для получения достижения"
          },
          {
            "name": "rewardId",
            "type": "integer",
            "required": true,
            "description": "ID награды XP, выдаваемой за получение достижения"
          },
          {
            "name": "nextId",
            "type": "integer",
            "required": false,
            "description": "ID следующего достижения в цепочке прогрессии (если есть)"
          },
          {
            "name": "icon",
            "type": "file",
            "required": true,
            "description": "Изображение иконки достижения (JPG/PNG, до 5 МБ)"
          }
        ],
        "example": {
          "code": "map_explorer_bronze",
          "title": "Картограф (бронза)",
          "desc": "Создайте 10 меток на карте",
          "triggerEvent": "mark.created",
          "threshold": 10,
          "rewardId": 2,
          "nextId": 16,
          "icon": "<binary>"
        }
      },
      "responses": [
        {
          "statusCode": 200,
          "description": "Достижение создано",
          "schema": [
            {
              "name": "achievement",
              "type": "object",
              "required": true,
              "description": "Созданное достижение",
              "children": [
                {
                  "name": "id",
                  "type": "integer",
                  "required": true,
                  "description": "ID достижения"
                },
                {
                  "name": "code",
                  "type": "string",
                  "required": true,
                  "description": "Машинный код"
                },
                {
                  "name": "title",
                  "type": "string",
                  "required": true,
                  "description": "Название"
                },
                {
                  "name": "desc",
                  "type": "string",
                  "required": true,
                  "description": "Описание"
                },
                {
                  "name": "triggerEventType",
                  "type": "string",
                  "required": true,
                  "description": "Тип триггерного события"
                },
                {
                  "name": "threshold",
                  "type": "integer",
                  "required": true,
                  "description": "Порог получения"
                },
                {
                  "name": "icon",
                  "type": "string",
                  "required": true,
                  "description": "URL иконки"
                },
                {
                  "name": "reward",
                  "type": "object",
                  "required": false,
                  "description": "XP-награда (опционально)",
                  "children": [
                    {
                      "name": "id",
                      "type": "integer",
                      "required": true,
                      "description": "ID награды"
                    },
                    {
                      "name": "code",
                      "type": "string",
                      "required": true,
                      "description": "Код награды"
                    },
                    {
                      "name": "amount",
                      "type": "integer",
                      "required": true,
                      "description": "Количество XP"
                    }
                  ]
                },
                {
                  "name": "next",
                  "type": "object",
                  "required": false,
                  "description": "Следующая ступень в цепочке прогрессий (если есть)"
                }
              ]
            }
          ],
          "example": {
            "achievement": {
              "id": 15,
              "code": "map_explorer_bronze",
              "title": "Картограф (бронза)",
              "desc": "Создайте 10 меток на карте",
              "triggerEventType": "mark.created",
              "threshold": 10,
              "icon": "https://realtimemap.ru/store/photos/achievements/2026/05/icon.jpg",
              "reward": {
                "id": 2,
                "code": "mark.created",
                "amount": 100
              },
              "next": {
                "id": 16,
                "code": "map_explorer_silver",
                "title": "Картограф (серебро)",
                "desc": "Создайте 50 меток",
                "triggerEventType": "mark.created",
                "threshold": 50,
                "icon": "https://realtimemap.ru/store/photos/achievements/2026/05/icon2.jpg"
              }
            }
          }
        }
      ],
      "errors": [
        "unauthorized",
        "forbidden",
        "validation-error",
        "not-found",
        "conflict"
      ]
    },
    {
      "id": "get-all-achievements",
      "method": "GET",
      "path": "/api/v2/achievement/all",
      "summary": "Получить каталог всех достижений",
      "description": "Возвращает каталог достижений системы. Цепочки прогрессий схлопываются: на верхнем уровне отдаются только корневые достижения — те, на которые не ссылается через nextId ни одно другое достижение. Следующая ступень цепочки вкладывается в поле next и не дублируется отдельным элементом массива.\n\nГлубина вложенности ограничена одним уровнем: у вложенного в next достижения поле next не заполняется, а ступени глубже второй в ответ не попадают вовсе. Например, если в системе есть цепочка 1 → 2 → 3 и самостоятельное достижение 4, ответ будет содержать два элемента: достижение 1 с вложенным 2 и достижение 4. Достижение 3 не возвращается.\n\nЕсли родительское достижение мягко удалено (deleted_at), его дочернее достижение снова считается корневым и появляется на верхнем уровне.\n\nПараметры page и pageSize применяются к корневым достижениям, поэтому размер страницы соответствует количеству элементов в ответе. Ответ возвращается голым массивом — без обёртки items и без метаданных пагинации (total, totalPages и т.д.). Сортировка — по возрастанию id.",
      "tags": [
        "Достижения"
      ],
      "pagination": "page",
      "parameters": [
        {
          "name": "page",
          "type": "integer",
          "required": false,
          "description": "Номер страницы (по умолчанию 1)",
          "location": "query",
          "example": "1"
        },
        {
          "name": "pageSize",
          "type": "integer",
          "required": false,
          "description": "Размер страницы (1–100, по умолчанию 10)",
          "location": "query",
          "example": "10"
        }
      ],
      "responses": [
        {
          "statusCode": 200,
          "description": "Массив корневых достижений с вложенной следующей ступенью",
          "schema": [
            {
              "name": "[]",
              "type": "object[]",
              "required": true,
              "description": "Массив корневых достижений (голый массив, без обёртки)",
              "children": [
                {
                  "name": "id",
                  "type": "integer",
                  "required": true,
                  "description": "ID достижения"
                },
                {
                  "name": "code",
                  "type": "string",
                  "required": true,
                  "description": "Машинный код"
                },
                {
                  "name": "title",
                  "type": "string",
                  "required": true,
                  "description": "Название"
                },
                {
                  "name": "desc",
                  "type": "string",
                  "required": true,
                  "description": "Описание"
                },
                {
                  "name": "triggerEventType",
                  "type": "string",
                  "required": true,
                  "description": "Тип триггерного события"
                },
                {
                  "name": "threshold",
                  "type": "integer",
                  "required": true,
                  "description": "Порог получения"
                },
                {
                  "name": "icon",
                  "type": "string",
                  "required": true,
                  "description": "URL иконки"
                },
                {
                  "name": "reward",
                  "type": "object",
                  "required": false,
                  "description": "XP-награда. Отсутствует, если награда не задана",
                  "children": [
                    {
                      "name": "id",
                      "type": "integer",
                      "required": true,
                      "description": "ID награды"
                    },
                    {
                      "name": "code",
                      "type": "string",
                      "required": true,
                      "description": "Код награды"
                    },
                    {
                      "name": "amount",
                      "type": "integer",
                      "required": true,
                      "description": "Количество XP"
                    }
                  ]
                },
                {
                  "name": "next",
                  "type": "object",
                  "required": false,
                  "description": "Следующая ступень цепочки. Вложенность ограничена одним уровнем — у этого объекта поле next отсутствует. У достижений вне цепочки поле отсутствует"
                }
              ]
            }
          ],
          "example": [
            {
              "id": 15,
              "code": "map_explorer_bronze",
              "title": "Картограф (бронза)",
              "desc": "Создайте 10 меток на карте",
              "triggerEventType": "mark.created",
              "threshold": 10,
              "icon": "https://realtimemap.ru/store/photos/achievements/2026/05/icon.jpg",
              "reward": {
                "id": 2,
                "code": "mark.created",
                "amount": 100
              },
              "next": {
                "id": 16,
                "code": "map_explorer_silver",
                "title": "Картограф (серебро)",
                "desc": "Создайте 50 меток",
                "triggerEventType": "mark.created",
                "threshold": 50,
                "icon": "https://realtimemap.ru/store/photos/achievements/2026/05/icon2.jpg",
                "reward": {
                  "id": 5,
                  "code": "mark.created.silver",
                  "amount": 250
                }
              }
            },
            {
              "id": 7,
              "code": "first_comment",
              "title": "Первый комментарий",
              "desc": "Оставьте первый комментарий",
              "triggerEventType": "comment.created",
              "threshold": 1,
              "icon": "https://realtimemap.ru/store/photos/achievements/2026/05/cmt.jpg",
              "reward": {
                "id": 3,
                "code": "comment.created",
                "amount": 50
              }
            }
          ]
        }
      ],
      "errors": [
        "validation-error",
        "internal-error"
      ]
    },
