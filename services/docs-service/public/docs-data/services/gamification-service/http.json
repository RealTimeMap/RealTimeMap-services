    {
      "id": "get-user-achievements",
      "method": "GET",
      "path": "/api/v2/achievement/user/{userID}",
      "summary": "Получить достижения пользователя",
      "description": "Возвращает список полученных пользователем достижений с пагинацией. Прогрессии (цепочки достижений Bronze → Silver → Gold) схлопываются — возвращается только верхняя достигнутая ступень с информацией о следующей цели через поле next. Одиночные достижения (без цепочки) возвращаются без поля next.\n\nОбратите внимание: значения page и pageSize в ответе повторяют параметры ровно так, как их прислал клиент. Если параметры не переданы, в ответе будут page: 0 и pageSize: 0, хотя выборка фактически выполняется с page=1 и pageSize=10.",
      "tags": [
        "Достижения"
      ],
      "pagination": "page",
      "parameters": [
        {
          "name": "userID",
          "type": "integer",
          "required": true,
          "description": "ID пользователя",
          "location": "path",
          "example": "1"
        },
        {
          "name": "page",
          "type": "integer",
          "required": false,
          "description": "Номер страницы (по умолчанию 1)",
          "location": "query",
          "example": "1"
        },
        {
          "name": "pageSize",
          "type": "integer",
          "required": false,
          "description": "Размер страницы (1–100, по умолчанию 10)",
          "location": "query",
          "example": "10"
        }
      ],
      "responses": [
        {
          "statusCode": 200,
          "description": "Список полученных достижений пользователя",
          "schema": [
            {
              "name": "items",
              "type": "object[]",
              "required": true,
              "description": "Массив полученных достижений",
              "children": [
                {
                  "name": "achievement",
                  "type": "object",
                  "required": true,
                  "description": "Данные достижения",
                  "children": [
                    {
                      "name": "id",
                      "type": "integer",
                      "required": true,
                      "description": "ID достижения"
                    },
                    {
                      "name": "code",
                      "type": "string",
                      "required": true,
                      "description": "Машинный код"
                    },
                    {
                      "name": "title",
                      "type": "string",
                      "required": true,
                      "description": "Название"
                    },
                    {
                      "name": "desc",
                      "type": "string",
                      "required": true,
                      "description": "Описание"
                    },
                    {
                      "name": "triggerEventType",
                      "type": "string",
                      "required": true,
                      "description": "Тип триггерного события"
                    },
                    {
                      "name": "threshold",
                      "type": "integer",
                      "required": true,
                      "description": "Порог получения"
                    },
                    {
                      "name": "icon",
                      "type": "string",
                      "required": true,
                      "description": "URL иконки"
                    },
                    {
                      "name": "reward",
                      "type": "object",
                      "required": false,
                      "description": "XP-награда",
                      "children": [
                        {
                          "name": "id",
